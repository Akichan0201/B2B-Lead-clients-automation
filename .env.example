# ==============================================================================
# B2B LEAD INTELLIGENCE SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Gemini AI Credentials
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Search API Credentials (Serper.dev or Google Custom Search)
# Serper API Key (Recommended): https://serper.dev
SEARCH_API_KEY=your_serper_api_key_here
# Optional: If using Google Custom Search API
GOOGLE_SEARCH_ENGINE_ID=your_custom_search_engine_id_here

# 3. PostgreSQL Database Credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lead_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# 4. Instant Alerting Credentials (HOT Leads)
# Telegram Bot Token & Chat ID (Create via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 5. Business & Stage 2 Outreach Credentials
COMPANY_NAME="Your Tech Agency Name"
COMPANY_WEBSITE="https://yourtechagency.com"
COMPANY_DESCRIPTION="Software Development & AI Automation Agency"
CALENDAR_BOOKING_LINK="https://calendly.com/your-agency/30min"
WHATSAPP_PHONE="+6281234567890"

# 6. Workflow Operational Settings
LEAD_SCORE_THRESHOLD=40
MAX_RESULTS_PER_SOURCE=10
